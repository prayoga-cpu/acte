# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgres://acte:acte@localhost:5432/acte

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encryption: key-encryption key used to wrap per-firm data keys (32 bytes, base64)
ACTE_KEK=

# Feature flags
COMPLIANCE_CLAIMS_ENABLED=false

# Email (Brevo)
BREVO_API_KEY=

# Payments (stage 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Errors (Sentry EU)
SENTRY_DSN=
